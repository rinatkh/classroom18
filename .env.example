# Local demo only. Generate a different secret before sharing the stack.
JWT_SECRET=local-lesson18-demo-secret-change-me-0123456789
POSTGRES_PASSWORD=local-demo-only
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
COOKIE_SECURE=false
REFRESH_COOKIE_NAME=refresh_token
# Host processes use these. Compose overrides addresses with service DNS names.
DATABASE_URL=postgres://postgres:local-demo-only@localhost:5432/task_api?sslmode=disable
REDIS_URL=redis://localhost:6379/0
KAFKA_BROKERS=localhost:19092
KAFKA_TOPIC=task.events
API_GRPC_ADDR=localhost:50051
GRPC_ADDR=127.0.0.1:50051
AUTOMATION_HTTP_ADDR=127.0.0.1:8090
